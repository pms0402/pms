{
  "name": "echoes-of-the-seventh-bell",
  "version": "0.7.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "verify:live": "node verify-live.mjs",
    "test:interaction": "node tests/fullscreen-browser.mjs",
    "test:chapters": "node tests/chapters-browser.mjs",
    "test:archive": "node tests/chapters-browser.mjs && node tests/archive-browser.mjs",
    "test:workshops": "node tests/chapters-browser.mjs && node tests/workshops-browser.mjs",
    "test:palace": "node tests/chapters-browser.mjs && node tests/archive-browser.mjs && node tests/palace-browser.mjs",
    "test:action": "node tests/chapters-browser.mjs && node tests/archive-browser.mjs && node tests/palace-browser.mjs && node tests/action-browser.mjs",
    "test:tutorial": "node tests/tutorial-browser.mjs",
    "test:motion": "node tests/motion-browser.mjs",
    "test:reset": "node tests/reset-browser.mjs"
  }
}
